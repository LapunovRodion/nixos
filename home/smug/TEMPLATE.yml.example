# ШПАРГАЛКА по формату smug. Копируется под новый проект:
#
#   cp home/smug/TEMPLATE.yml.example home/smug/мойпроект.yml
#   # дописать строку в home/home.nix рядом с smug/nixos.yml
#   ns
#
# Этот файл НЕ подключается в ~/.config/smug — он нужен только здесь, при
# правке конфигов. Расширение .example, а не .yml, чтобы даже случайно не
# попасть в список сессий.
#
# Второй способ, без правки этого флейка вообще: положить файл `.smug.yml`
# в корень самого проекта. smug подхватывает его из ТЕКУЩЕГО каталога, так
# что описание сессии едет в репозитории проекта, а не тут.
#
# =====================================================================
# ЗАПУСК
#   smug start имя              поднять сессию
#   smug start имя:okno1,okno2  только эти окна
#   smug start имя -w okno      то же самое другим синтаксисом
#   smug start имя --worktree ветка   корнем взять git worktree этой ветки
#   smug start имя -i           окна создать ВНУТРИ текущей сессии
#   smug start имя --detach     поднять, но не прицепляться
#   smug start -f путь.yml      конфиг откуда угодно
#   smug stop имя               убить (выполнив stop-команды)
#   smug print                  выплюнуть ТЕКУЩУЮ сессию в yaml
#   smug list / edit / new / rm
#   -d                          лог всех команд в ~/.config/smug/smug.log
#
# ВНИМАНИЕ про `smug print`: он снимает живую сессию довольно грубо —
# схлопывает панели окна в одну запись, теряет каталоги отдельных панелей
# и НЕ снимает запущенные программы (commands остаётся пустым). Годится
# как черновик скелета, не как готовый конфиг.
# =====================================================================

# Имя сессии. По нему же зовётся smug start.
session: имяпроекта

# Базовый каталог. ~ раскрывается (проверено). Каждое окно и каждая
# панель наследуют его, если не переопределят своим root.
root: ~/projects/имяпроекта

# Переменные окружения для всех панелей сессии.
# env:
#   FOO: bar

# Команды ДО создания сессии — поднять базу, докер, туннель.
# Выполняются в шелле, не в tmux.
# before_start:
#   - docker compose up -d

# Команды при `smug stop` — симметрично before_start.
# stop:
#   - docker compose stop

# Хуки на подключение/отключение клиента.
# attach_hook: ""
# detach_hook: ""

windows:
  - name: editor
    # Свой каталог у окна; относительный путь считается от root сессии.
    # root: ./src

    # Команды уходят в первую панель окна.
    commands:
      - nvim .

    # true — окно НЕ поднимается само, только по `smug start имя -w editor`.
    # Удобно для тяжёлого: дев-сервер, сборка в watch-режиме.
    # manual: false

    # На каком окне оказаться после старта.
    # selected: true

    # Раскладка панелей. Именованные значения tmux (main-vertical,
    # main-horizontal, even-horizontal, even-vertical, tiled) переносимы.
    # Сырая строка вида "8205,80x24,0,0{...}", которую выдаёт smug print,
    # привязана к размеру терминала В МОМЕНТ СНЯТИЯ — на другой машине с
    # другим разрешением она разъедется. Держаться именованных.
    #
    # ЭТО ПОЛЕ И РЕШАЕТ, а не type у панелей ниже. Видно в логе команд
    # (smug start -d, лог в ~/.config/smug/smug.log): после всех
    # split-window smug БЕЗУСЛОВНО догоняет
    #   tmux select-layout -t @N tiled
    #   tmux select-layout -t @N <layout>
    # где <layout> — значение отсюда, а если поля нет — even-horizontal.
    # Поэтому направление разреза из type затирается, и окно без layout
    # выстраивает панели в РЯД, что бы в type ни стояло.
    # layout: main-vertical

    # Дополнительные панели В ЭТОМ окне. Первая панель уже есть — это та,
    # куда ушли commands выше; здесь описываются ВТОРАЯ и далее.
    # panes:
    #   - type: vertical      # флаг для split-window: vertical → -v,
    #     root: ./logs        #   horizontal → -h. На КОНЕЧНЫЙ вид влияет
    #     commands:           #   слабо, см. про layout выше.
    #       - tail -f app.log

  - name: git
    commands:
      - lazygit

  # Пустое окно: команд нет — остаётся голый шелл.
  - name: shell
