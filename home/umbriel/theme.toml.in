# Шаблон темы umbriel — ВХОД для генератора палитры noctalia.
#
# Это не рабочий конфиг: {{...}} подставляет noctalia при каждой смене
# палитры (у меня source = "wallpaper", то есть при каждой смене обоев).
# Результат ложится в ~/.config/umbriel/noctalia.toml, который подключён
# строкой include.files в самом верху сгенерированного config.toml
# (см. home/umbriel.nix).
#
# Объявление шаблона — в home/noctalia.nix, [theme.templates.user.umbriel].
# ВСТРОЕННЫЙ шаблон "umbriel" не используется намеренно: его apply.sh
# дописывает строку include в ~/.config/umbriel/config.toml, а тот у нас
# read-only симлинк в /nix/store — post_hook падал бы на каждой смене
# обоев. Ровно та же грабля, из-за которой отключён шаблон neovim.
#
# --- ПОРЯДОК СКЛЕЙКИ ---
# У niri последний include перебивал главный файл. У umbriel НАОБОРОТ:
# главный файл перебивает все include. Поэтому всё, что задано здесь,
# в home/umbriel.nix задавать НЕЛЬЗЯ — иначе оно перекроет палитру и
# цвета замрут, причём молча.
#
# Роли палитры берутся из Material You: primary — основной акцент,
# tertiary — контрастная к нему пара. Полный список ролей:
# assets/templates/*/ в исходниках noctalia.
#
# Чего здесь нет по сравнению с прежним шаблоном niri: градиентов.
# У umbriel цвета рамок сплошные, active-gradient аналога не имеет.

[colors]
background = "#{{colors.surface_container.default.hex_stripped}}FF"
text_primary = "#{{colors.on_surface.default.hex_stripped}}FF"
text_muted = "#{{colors.on_surface_variant.default.hex_stripped}}FF"
accent_primary = "#{{colors.primary.default.hex_stripped}}FF"
accent_secondary = "#{{colors.secondary.default.hex_stripped}}FF"
warning = "#{{colors.tertiary.default.hex_stripped}}FF"
error = "#{{colors.error.default.hex_stripped}}FF"

[appearance]
# Рамка активного окна — основной акцент, неактивного — поверхность.
border_focused = "#{{colors.primary.default.hex_stripped}}FF"
border_unfocused = "#{{colors.surface_variant.default.hex_stripped}}FF"
# Окна, убранные на полку (scratchpad), отличаются цветом рамки:
# tertiary — контрастная пара к primary.
scratchpad_border_focused = "#{{colors.tertiary.default.hex_stripped}}FF"
scratchpad_border_unfocused = "#{{colors.tertiary_container.default.hex_stripped}}FF"
outer_border_color = "#{{colors.terminal_background.default.hex_stripped}}FF"
insert_hint_color = "#{{colors.tertiary.default.hex_stripped}}80"
# Фон под полноэкранным окном.
backdrop_color = "#{{colors.surface_variant.default.hex_stripped}}FF"

# Тень под окнами. Геометрия (softness/offset) — в home/umbriel.nix,
# здесь только цвет, чтобы он ехал вместе с палитрой при смене обоев.
[appearance.shadow]
color = "#{{colors.shadow.default.hex_stripped}}70"

[overview]
# Подкраска поверх обоев, пока открыт overview.
background_tint = "#{{colors.surface.default.hex_stripped}}88"
# Подложка под каждым воркспейсом: без неё миниатюры сливаются с обоями.
# Заменяет прежнюю workspace-shadow из niri — теней в overview umbriel нет.
workspace_background = "#{{colors.surface_container.default.hex_stripped}}44"
