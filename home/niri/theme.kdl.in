// Шаблон темы niri — ВХОД для генератора палитры noctalia.
//
// Это не рабочий конфиг: {{...}} подставляет noctalia при каждой смене
// палитры (у меня source = "wallpaper", то есть при каждой смене обоев).
// Результат ложится в ~/.config/niri/noctalia-theme.kdl, который
// подключён последней строкой ~/nixos/niri/config.kdl. Последний include
// в niri перебивает то, что задано выше, поэтому заводские цвета из
// стокового config.kdl трогать не нужно — они просто перекрываются.
//
// Объявление шаблона — в ~/nixos/noctalia.nix, [theme.templates.user.niri].
// Заменяет ВСТРОЕННЫЙ шаблон "niri" (он убран из builtin_ids): тот писал
// плоский active-color, а мне нужен градиент. Держать оба нельзя — два
// файла определяли бы один focus-ring.
//
// Роли палитры берутся из Material You: primary — основной акцент,
// tertiary — контрастная к нему пара, ровно для градиентов.
// Полный список ролей: assets/templates/*/ в исходниках noctalia.

layout {

    // Рамка фокуса — градиентом через весь экран.
    // relative-to="workspace-view": градиент считается не по каждому окну,
    // а по всей видимой области воркспейса. Поэтому у окна слева и окна
    // справа рамка разного цвета — это и есть эффект.
    focus-ring {
        active-gradient from="{{colors.primary.default.hex}}" to="{{colors.tertiary.default.hex}}" angle=45 relative-to="workspace-view"
        inactive-color  "{{colors.surface.default.hex}}"
        urgent-color    "{{colors.error.default.hex}}"
    }

    // border выключен в config.kdl, но цвета держим в тон: включу — будет
    // сразу правильным, а не заводским.
    border {
        active-gradient from="{{colors.primary.default.hex}}" to="{{colors.tertiary.default.hex}}" angle=45 relative-to="workspace-view"
        inactive-color  "{{colors.surface.default.hex}}"
        urgent-color    "{{colors.error.default.hex}}"
    }

    shadow {
        color "{{colors.shadow.default.hex}}70"
    }

    tab-indicator {
        active-color   "{{colors.primary.default.hex}}"
        inactive-color "{{colors.primary_container.default.hex}}"
        urgent-color   "{{colors.error.default.hex}}"
    }

    insert-hint {
        color "{{colors.primary.default.hex}}80"
    }
}

recent-windows {
    highlight {
        active-color "{{colors.primary.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }
}
