# Соответствие клавиш ЙЦУКЕН ↔ QWERTY — один источник правды для всех
# приложений, которые ловят ОДИНОЧНЫЕ клавиши без модификатора.
#
# Хоткеи с Ctrl/Alt/Super чинятся на уровне xkb (см. home/xkb/*), туда эта
# таблица отношения не имеет. Но xkb не знает, в каком режиме приложение,
# поэтому normal mode в nvim, биндинги yazi и клавиши после префикса tmux
# приходится дублировать вручную. Чтобы дубликаты не разъехались между
# тремя конфигами, раскладка описана здесь один раз.
#
# Строки — списки, а НЕ строки-литералы, и это принципиально: длина строки
# в nix считается в БАЙТАХ, поэтому lib.stringToCharacters на кириллице
# режет символы пополам.

{ lib }:

let
  # Пары «латинский символ ↔ кириллический на той же физической клавише».
  rows = [
    # верхний буквенный ряд
    {
      en = [ "`" "q" "w" "e" "r" "t" "y" "u" "i" "o" "p" "[" "]" ];
      ru = [ "ё" "й" "ц" "у" "к" "е" "н" "г" "ш" "щ" "з" "х" "ъ" ];
    }
    {
      en = [ "~" "Q" "W" "E" "R" "T" "Y" "U" "I" "O" "P" "{" "}" ];
      ru = [ "Ё" "Й" "Ц" "У" "К" "Е" "Н" "Г" "Ш" "Щ" "З" "Х" "Ъ" ];
    }

    # средний ряд
    {
      en = [ "a" "s" "d" "f" "g" "h" "j" "k" "l" ";" "'" ];
      ru = [ "ф" "ы" "в" "а" "п" "р" "о" "л" "д" "ж" "э" ];
    }
    {
      en = [ "A" "S" "D" "F" "G" "H" "J" "K" "L" ":" "\"" ];
      ru = [ "Ф" "Ы" "В" "А" "П" "Р" "О" "Л" "Д" "Ж" "Э" ];
    }

    # нижний ряд. Последние три пары — не буквы: на них сидят `,` `.` `/`,
    # то есть поиск в vim и «повторить» — терять их нельзя.
    {
      en = [ "z" "x" "c" "v" "b" "n" "m" "," "." "/" ];
      ru = [ "я" "ч" "с" "м" "и" "т" "ь" "б" "ю" "." ];
    }
    {
      en = [ "Z" "X" "C" "V" "B" "N" "M" "<" ">" "?" ];
      ru = [ "Я" "Ч" "С" "М" "И" "Т" "Ь" "Б" "Ю" "," ];
    }
  ];

  pairs = lib.concatMap (
    row: lib.zipListsWith (en: ru: { inherit en ru; }) row.en row.ru
  ) rows;

  # В langmap экранируются обратный слэш, запятая и точка с запятой —
  # они у формата служебные, а в таблице встречаются с обеих сторон.
  esc = lib.escape [ "\\" "," ";" ];

in
rec {
  # [ { en = "q"; ru = "й"; } ... ] — для генераторов, которым нужен порядок.
  inherit pairs;

  # То же, но без пар, у которых кириллическая сторона — обычный ASCII:
  # `/` → `.` и `?` → `,`. Такие зеркала опасны, они бы перебили настоящий
  # латинский бинд на `.` и `,`. Для langmap это не важно (там перевод
  # применяется разом), а вот для tmux и yazi, где зеркало добавляется
  # отдельным биндом поверх существующих, — важно.
  # Признак — длина в БАЙТАХ: кириллица в utf-8 занимает два.
  mirrorPairs = lib.filter (p: builtins.stringLength p.ru > 1) pairs;

  # { "q" = "й"; "Q" = "Й"; ... } — та же mirrorPairs, но для поиска по клавише.
  # Имя клавиши, которого в таблице нет ("<C-y>", "<Esc>", "1"), просто не
  # находится, и вызывающий оставляет запись как была.
  mirrorMap = lib.listToAttrs (map (p: lib.nameValuePair p.en p.ru) mirrorPairs);

  # Значение для nvim'ового 'langmap': "<что нажал>;<что видит vim>".
  langmap =
    esc (lib.concatMapStrings (p: p.ru) pairs)
    + ";"
    + esc (lib.concatMapStrings (p: p.en) pairs);
}
