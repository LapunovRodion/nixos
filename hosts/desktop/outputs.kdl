// Выходы десктопа: три монитора 1920x1080, все три в RTX 3060.
// Подключается как ~/.config/niri/outputs.kdl строкой include в config.kdl.
//
// Имена сняты с живой машины (`niri msg outputs`), не угаданы:
//   HDMI-A-2 — Acer S221HQL
//   DP-2     — Dell P2214H
//   HDMI-A-1 — Samsung (модель в EDID не заполнена)
//
// DP-1 не существует: единственный DisplayPort определился как DP-2.
// Пока в файле стояло угаданное DP-1, блок игнорировался, место x=0
// оставалось пустым, а мониторы уезжали на 1920/3840/5760.
//
// position — координаты ЛЕВОГО ВЕРХНЕГО угла в общем логическом
// пространстве. При scale 1 логическая ширина равна физической, поэтому
// мониторы стыкуются по 1920: 0 → 1920 → 3840. Порядок здесь = порядок
// слева направо на столе; если физически они стоят иначе, менять надо
// именно x, а не порядок блоков.

output "HDMI-A-2" {
    mode "1920x1080"
    scale 1
    position x=0 y=0
}

output "DP-2" {
    mode "1920x1080"
    scale 1
    position x=1920 y=0
}

output "HDMI-A-1" {
    mode "1920x1080"
    scale 1
    position x=3840 y=0
}

// =============================================================
// Samsung (HDMI-A-1) — зеркало Acer (HDMI-A-2)
//
// Настоящего дублирования выходов у niri нет, поэтому зеркало делает
// wl-mirror: он захватывает содержимое одного выхода и показывает его
// обычным окном, которое правилом ниже разворачивается во весь экран
// на приёмнике.
//
// Файл подключается строкой include в config.kdl (верхний уровень),
// поэтому кроме блоков output {} сюда можно класть и правила окон.
// Здесь им и место: имена мониторов машинозависимые, а config.kdl
// общий с ноутом.
//
// ВАЖНО про --fullscreen-output: сам по себе флаг wl-mirror не
// сработал, проверено — окно открылось обычной плиткой на текущем
// выходе. Полный экран на нужном мониторе даёт именно правило ниже,
// поэтому в spawn-at-startup флага нет, только имя источника.
// =============================================================
spawn-at-startup "wl-mirror" "HDMI-A-2"

window-rule {
    match app-id=r#"^at\.yrlf\.wl_mirror$"#
    open-on-output "HDMI-A-1"
    open-fullscreen true
    // Не перехватывать фокус при запуске: иначе первое же окно после
    // логина открылось бы на зеркале.
    open-focused false
}
